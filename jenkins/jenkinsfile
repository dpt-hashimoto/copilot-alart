pipeline {
    agent any
    tools {
        maven 'Maven3.9.16'
        jdk 'java17'
    }
    stages {

        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/dpt-hashimoto/copilot-alart.git'
            }
        }

        stage('Build') {
            steps {
                bat 'mvn -Dmaven.test.failure.ignore=true clean package'
            }
        }

        stage('Create Release') {
            steps {
        
                bat '''
                if exist copilot-alart rmdir /S /Q copilot-alart
                if exist copilot-alart.zip del /Q copilot-alart.zip
        
                mkdir copilot-alart
        
                xcopy /E /I /Y release copilot-alart\\
                xcopy /E /I /Y target\\runtime copilot-alart\\runtime
        
                copy target\\copilot-alart-1.0.0.jar copilot-alart
        
                powershell -Command "Compress-Archive -Path copilot-alart\\* -DestinationPath copilot-alart.zip -Force"
                '''
            }
        }
    }
    post {
        success {
            archiveArtifacts artifacts: 'copilot-alart/**, copilot-alart.zip', fingerprint: true
        }
    }
}